{
    "name": "hasinhayder/tyro-checkpoint",
    "description": "Database checkpoint management for Laravel local development (SQLite only)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hasin Hayder",
            "email": "hasin@hasinhayder.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HasinHayder\\TyroCheckpoint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HasinHayder\\TyroCheckpoint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HasinHayder\\TyroCheckpoint\\TyroCheckpointServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
