{
    "name": "hasinhayder/tyro-checkpoint",
    "description": "Database checkpoints for Laravel local development. Snapshot your database and restore it instantly. Supports SQLite, MySQL, and PostgreSQL.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hasin Hayder",
            "email": "hasin@hasinhayder.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "symfony/process": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "HasinHayder\\TyroCheckpoint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HasinHayder\\TyroCheckpoint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HasinHayder\\TyroCheckpoint\\TyroCheckpointServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
